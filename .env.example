# Hermes Mobile Capture BFF local/staging configuration
# Copy to .env locally if you wrap the Python server with a process manager.

# Path to Hermes home where the mobile-capture HMAC secret lives.
# Never commit the real secret file.
HERMES_HOME=/path/to/.hermes

# BFF bind config
MOBILE_CAPTURE_HOST=127.0.0.1
MOBILE_CAPTURE_PORT=8650

# Optional explicit paths
MOBILE_CAPTURE_SECRET_FILE=/path/to/.hermes/mobile-capture-v1-secret.txt
MOBILE_CAPTURE_LEDGER=backend/data/mobile_capture_ledger.sqlite

# Candidate implementation only; leave disabled until reviewed deployment and
# domain handoff. Environment flags do not authorize general/Argos dispatch.
MOBILE_CAPTURE_WRITE_ENABLED=0
MOBILE_CAPTURE_WRITE_DOMAINS=
# Supported values: aura.grocery_capture,aura.reminder_capture,megan.expense_capture

# Aura is an external adapter, not bundled in this repository. Its exact source
# and persistent state must be reviewed before enabling groceries/reminders.
MOBILE_CAPTURE_AURA_HELPER=/path/to/reviewed/apple_watch_capture.py
MOBILE_CAPTURE_EXPENSE_HELPER=backend/scripts/mobile_expense_capture.py

# Server-only existing Firefly configuration. Do not put these on the Watch.
FIREFLY_BASE_URL=https://firefly.example.invalid
FIREFLY_API_TOKEN_FILE=/path/to/private/firefly-token.txt

# Public-safe placeholder. Replace locally with your tailnet DNS name.
TAILSCALE_DNS_NAME=your-node.your-tailnet.ts.net
